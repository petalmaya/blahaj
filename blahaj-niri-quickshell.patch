+
+      border {
+        color: Dat.Colors.current.primary
+        width: 3
+      }
+
+      Gen.MouseArea {
+        cursorShape: Qt.PointingHandCursor
+        layerColor: icon.color
+
+        onClicked: root.onClicked()
